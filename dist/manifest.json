{
  "name": "Pixiv Fanbox Downloader for Firefox",
  "version": "4.9.4",
  "manifest_version": 3,
  "description": "Batch download files from Pixiv Fanbox in Firefox.",
  "icons": {
    "16": "icon/logo16.png",
    "32": "icon/logo32.png",
    "48": "icon/logo48.png",
    "128": "icon/logo128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon/logo16.png",
      "32": "icon/logo32.png",
      "48": "icon/logo48.png",
      "128": "icon/logo128.png"
    },
    "default_title": "Pixiv Fanbox Downloader"
  },
  "content_scripts": [
    {
      "js": ["lib/listen_history_change.js"],
      "matches": ["*://*.fanbox.cc/*"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "css": ["style/style.css"],
      "js": ["js/content.js", "lib/iconfont.js"],
      "matches": ["*://*.fanbox.cc/*"],
      "run_at": "document_end"
    }
  ],
  "background": {
    "scripts": ["js/background.js"]
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.fanbox.cc/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon/logo128.png",
        "images/cardMask.png"
      ],
      "matches": ["*://*.fanbox.cc/*"]
    }
  ],
  "incognito": "spanning",
  "homepage_url": "https://github.com/iNeed-ssd/PixivFanboxDownloader_for_firefox",
  "browser_specific_settings": {
    "gecko": {
      "id": "pixiv-fanbox-downloader@ineed-ssd",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
